 /** 
 *  EMITTER HUFF EXERCISE
 *  
 *  The task is to enable this contract, when the function `value(uint256, uint256)` is called, should
 *  emit an event named `Value(uint256 indexed, uint256)`
 *
 *  NOTICE: The contract should revert when an unrecognized function is called
 */

 #define function value(uint256, uint256) payable returns()
 
 #define event Value(uint256 indexed, uint256)

 #define macro VALUE() = takes(0) returns(0) {
    0x24                                // [0x24]  
    calldataload                        // [arg_2]
    0x00 mstore                         // [] Store arg_2 at memory location 0x00

    0x04                                // [0x04]
    calldataload                        // [arg_1]
                                        // [] Store arg_1 at memory location 0x04

    __EVENT_HASH(Value)                 // [event_hash, arg_1] Push the event hash of `Value` onto the stack                               

    0x20                                // [0x20, event_hash, arg_1]
    0x00                                // [0x00, event_hash, arg_1] [offset, size, topic1, topic2]
    log2                                // []                
 
    0x00 0x00 return                    // Return, specifying start of return data at memory location 0x00 and length 0x00 (no return data)
 }



 #define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload                   // [calldata]
    0xe0 shr                            // [selector]       

    __FUNC_SIG(value) eq                // Jump if selector matches
    value jumpi     

    0x00 0x00 revert

    value:
        VALUE()
 }
