
/** 
 *  SUM_ARRAY HUFF EXERCISE
 *
 *  
 *  The task is to write within the `MAIN` macro below, write a functionality that takes 
    an array of uint256 as an argument and returns the sum of all the numbers
 *
 *  NOTICE: The contract should revert when an unrecognized function is calledu
 */

#define function sumArray(uint256[]) payable returns(uint256)

#define macro SUM_ARRAY() = takes(0) returns(0) {
    0x44                          // [0x44] 
    calldatasize                  // [calldatasize, 0x44] 
    sub                           // [length] 
    push0                         // [sum = 0, length] 
    push0                         // [i = 0, sum, length] 

    loopStart:                    
        dup3                      // [length, i, sum, length] 
        dup2                      // [i, length, i, sum, length]

        0x20                      // [32, i, length, i, sum, length]
        mul                       // [32*i, length, i, sum, length]
        lt                        // [1 | 0, i, sum, length]
        iszero finish jumpi       // [i, sum, length]
       
        dup1                      // [i, i, sum, length]
        0x20                      // [32, i, i, sum, length]
        mul                       // [i*32, i, sum, length]
        0x44                      // [0x44, i*32, sum, length] 
        add                       // [i*32 + 0x44, sum, length]
        
        calldataload              // [data_value, sum, i, length] - Load the data at the calculated offset
        dup3                      // [sum, data_value, sum, i, length] - Duplicate sum for addition

        add                       // [new_sum, i, length] - Add data_value to sum
        swap2 pop                 // [i, new_sum, length] - Swap i and new_sum, pop old i
        0x1 add                   // [i+1, new_sum, length] - Increment i by 1
        loopStart jump            // Jump back to the start of the loop
    
    finish:
        pop                       // [new_sum] - Pop the length off the stack, leaving only the sum
        0x00                      // [0x00, new_sum]
        mstore                    // [] - Store new_sum at memory offset 0
        0x20                      // [0x20]
        0x00                      // [0x00, 0x20]
        return                    // Return 32 bytes starting from memory location 0
}


#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload                                // [calldata]
    0xe0 shr                                         // [selector]         

    __FUNC_SIG(sumArray) eq  
    sumArray jumpi     

    0x00 0x00 revert

    sumArray:
        SUM_ARRAY()

}