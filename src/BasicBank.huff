/** 
 *  BASIC_BANK HUFF EXERCISE
 *  
 *  The task is to create a basic bank with huff
 * functionalities include
 *      - depositing tokens via similar to how solidity's `receive` function works
 *      - withdrawing tokens
 *      - keeping track of and viewing balance
 */

#define constant BALANCE_SLOT = FREE_STORAGE_POINTER()  

#define function balanceOf(address) payable returns(uint256)
#define function withdraw(uint256) payable returns()

// Calculates the storage slot in a key-based contract using a hash function
#define macro GET_SLOT_FROM_KEY(mem_ptr) = takes(1) returns (1) {
                            // [key]
                            // offset, value
    <mem_ptr>               // [<mem_ptr>, key]
    mstore                  // []

                            // Hash the data, generating a key
    0x20                    // [32]
    <mem_ptr>               // [<mem_ptr>, 32]
    sha3                    // [slot]
}

// Store an element from a key
#define macro STORE_ELEMENT(mem_ptr) = takes(2) returns(0) {
                                    // [key, value]
    GET_SLOT_FROM_KEY(<mem_ptr>)    // [slot, value]
    sstore                          // []
}

// Load an element onto the stack from a key
#define macro LOAD_ELEMENT(mem_ptr) = takes(1) returns(1) {
                                    // [key]
    GET_SLOT_FROM_KEY(<mem_ptr>)    // [slot]
    sload                           // [value]
}

#define macro BALANCE_OF() = takes(0) returns(0) {
    0x04 calldataload                // [value]
    LOAD_ELEMENT(BALANCE_SLOT)       // [balance]
    0x00 mstore                      // []
    0x20 0x00 return                 
}

#define macro WITHDRAW() = takes(0) returns(0) {
    caller                            // [caller]
    LOAD_ELEMENT(BALANCE_SLOT)        // [balance]
    0x04 calldataload                 // [value, balance]
    gt                                // [1 | 0]
    iszero send jumpi                 // []

    0x00 0x00 revert

    send:
        0x00                     // [retSize]
        0x00                     // [retOffset, retSize]
        0x20                     // [argSize, retOffset, retSize]
        0x04                     // [argOffset, argSize, retOffset, retSize]
        0x04 calldataload        // [value, argOffset, argSize, retOffset, retSize]
        caller                   // [to, value, argOffset, argSize, retOffset, retSize]
        0x6000                   // [gas, to, value, argOffset, argSize, retOffset, retSize]
        call                     // [success]
        stop
}

#define macro RECEIVE() = takes(0) returns(0) {
    0x00                                           // [0x00]
    callvalue                                      // [value, 0x00]
    gt                                             // [1 | 0]
    continue jumpi                                 // []
    
    continue:
      callvalue                                    // [value]
      caller                                       // [caller, value]
      dup1                                         // [caller, caller, value]
      LOAD_ELEMENT(BALANCE_SLOT)                   // [balance, caller, value]
      dup1                                         // [balance, balance, caller, value]
      iszero finish jumpi                          // [balance, caller, value]

    receive_finish jump

    receive_finish:                                 // [balance, caller, value]
        dup3                                        // [value, balance, caller, value]
        add                                         // [value+balance, caller, value]
        swap1                                       // [caller, value+balance, value]
        STORE_ELEMENT(BALANCE_SLOT)                 // [value]
        pop                                         // []
        stop                                        // []
  
    finish:                                         // [balance, caller, value]
        pop                                         // caller, value]
        STORE_ELEMENT(BALANCE_SLOT)                 // []
        stop
}

#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload                                // [calldata]
    0xe0 shr                                         // [selector]

    // Check selector
    dup1 __FUNC_SIG(balanceOf) eq balanceOf jumpi    // Jump if selector matches
    dup1 __FUNC_SIG(withdraw) eq withdraw jumpi      // Jump if selector matches

    receive jump                                     // Jump if selector does not match

    balanceOf:
        BALANCE_OF()

    withdraw:
        WITHDRAW()

    receive:
        RECEIVE()
}
