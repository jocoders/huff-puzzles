
/** 
 *  MULTIPLY HUFF EXERCISE
 *
 *  When writing solidity, we most times have to perform some mathematical operations like multiplication etc
 *  
 *  The task is to write within the `MAIN` macro below, a function named `multiply` that takes in 2 uint256s, and returns their product. Be sure to revert on overflow
 *
 *  NOTICE: The contract should revert when an unrecognized function is called
 */

#define function multiply(uint256, uint256) payable returns(uint256)

#define macro MULTIPLY() = takes(0) returns(0) {
    0x04                      // 0x04
    calldataload              // [arg_1] - Load the first argument from calldata at offset 0x04
    dup1                      // [arg_1, arg_1]
    iszero ret jumpi          // [arg_1]

    0x24                      // [0x24, arg_1]
    calldataload              // [arg_2, arg_1]
    swap1                     // [arg_1, arg_2] 
    dup2                      // [arg_2, arg_1, arg_2]
    dup2                      // [arg_1, arg_2, arg_1, arg_2]
    mul                       // [mul_res, arg_1, arg_2]
    dup1                      // [mul_res, mul_res, arg_1, arg_2]
    0x00                      // [0x00, mul_res, mul_res, arg_1, arg_2]
    mstore                    // [mul_res, arg_1, arg_2]
    div                       // [div_res, arg_1]
    eq ret jumpi              // [1 | 0, arg_1]

    0x00                      // [0x00, arg_1]
    0x00                      // [0x00, 0x00, arg_1]
    revert                    // Revert the transaction if overflow is detected

    ret:
        0x20                  // [0x20, arg_1]
        0x00                  // [0x00, 0x20, arg_1]
        return                // Return 32 bytes starting from memory location 0x00
}


#define macro MAIN() = takes(0) returns(0) {
    0x00 calldataload                                // [calldata]
    0xe0 shr                                         // [selector]

    __FUNC_SIG(multiply) eq multiply jumpi

    0x00 0x00 revert

    multiply:
       MULTIPLY()
        
}