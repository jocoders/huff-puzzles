
/** 
 *  EXAMPLE HUFF EXERCISE - RETURN 1 ()
 *
 *  This huff contract simply returns 1 whenever it is called with/without data and with/without ether
 */


#define macro MAIN() = takes(0) returns(0) {
    0x01                         // [0x01] - Push the constant value 1 onto the stack
    0x00                         // [0x00, 0x01] - Push the memory offset 0 onto the stack
    mstore                       // [] - Store the value 1 at memory offset 0
    0x20                         // [0x20] - Push the size of the data to return (32 bytes) onto the stack
    0x00                         // [0x00, 0x20] - Push the start position of the data in memory (offset 0) onto the stack
    return                       // [] - Return 32 bytes starting from memory location 0
}